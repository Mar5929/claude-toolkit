{
  "description": "Load this project's knowledge manual and small project map at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/knowledge-session-start.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.claude/hooks/knowledge-session-start.mjs')\"",
            "timeout": 10,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading the knowledge manual and project map"
          }
        ]
      }
    ]
  }
}

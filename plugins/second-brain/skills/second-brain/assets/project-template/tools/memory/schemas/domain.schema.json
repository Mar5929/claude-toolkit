{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain-v2:domain:1",
  "title": "Domain frontmatter",
  "allOf": [
    { "$ref": "record-common.schema.json" },
    {
      "properties": {
        "record_type": { "const": "domain" },
        "lifecycle": { "enum": ["proposed", "active", "superseded", "retired"] }
      }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "active" } }, "required": ["lifecycle"] },
      "then": {
        "properties": {
          "freshness": { "const": "current" },
          "verification": { "enum": ["verified", "owner_reviewed", "repository_evidence", "not_applicable"] }
        }
      }
    }
  ]
}

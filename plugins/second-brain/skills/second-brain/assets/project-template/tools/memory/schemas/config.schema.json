{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain-v2:config:1",
  "title": "Second-brain v2 project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "profile",
    "modules",
    "canonical_paths",
    "authorities",
    "budgets",
    "index",
    "external_authorities"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$" },
    "profile": { "enum": ["core", "software", "client", "data", "regulated", "platform"] },
    "modules": { "type": "array", "contains": { "const": "core" }, "items": { "type": "string" }, "uniqueItems": true },
    "canonical_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_router", "specifications", "memory", "current_context", "decisions", "knowledge", "references", "domain", "operations", "task_tracker"],
      "properties": {
        "project_router": { "$ref": "#/$defs/path" },
        "specifications": { "$ref": "#/$defs/path" },
        "memory": { "$ref": "#/$defs/path" },
        "current_context": { "$ref": "#/$defs/path" },
        "decisions": { "$ref": "#/$defs/path" },
        "knowledge": { "$ref": "#/$defs/path" },
        "references": { "$ref": "#/$defs/path" },
        "domain": { "$ref": "#/$defs/path" },
        "operations": { "$ref": "#/$defs/path" },
        "task_tracker": { "$ref": "#/$defs/path" }
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desired_behavior", "architecture_decisions", "implemented_behavior", "terminology", "source_authority", "task_status", "deployed_state", "agent_rules"],
      "properties": {
        "desired_behavior": { "type": "string", "minLength": 1 },
        "architecture_decisions": { "type": "string", "minLength": 1 },
        "implemented_behavior": { "type": "string", "minLength": 1 },
        "terminology": { "type": "string", "minLength": 1 },
        "source_authority": { "type": "string", "minLength": 1 },
        "task_status": { "type": "string", "minLength": 1 },
        "deployed_state": { "type": "string", "minLength": 1 },
        "agent_rules": { "type": "string", "minLength": 1 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_router_max_bytes", "startup_max_bytes", "task_retrieval_max_bytes", "current_max_bytes", "current_max_nonempty_lines", "search_max_results"],
      "properties": {
        "project_router_max_bytes": { "type": "integer", "minimum": 1 },
        "startup_max_bytes": { "type": "integer", "minimum": 1 },
        "task_retrieval_max_bytes": { "type": "integer", "minimum": 1 },
        "current_max_bytes": { "type": "integer", "minimum": 1, "maximum": 3072 },
        "current_max_nonempty_lines": { "type": "integer", "minimum": 1, "maximum": 40 },
        "search_max_results": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "schema_version", "modes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schema_version": { "const": 1 },
        "modes": { "type": "array", "items": { "const": "exact" }, "uniqueItems": true }
      }
    },
    "external_authorities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}

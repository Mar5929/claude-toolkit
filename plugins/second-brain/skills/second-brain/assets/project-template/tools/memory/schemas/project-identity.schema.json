{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain-v2:project-identity:1",
  "title": "Repository-bound project identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "repository_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$" },
    "repository_id": { "type": "string", "format": "uuid" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain-v2:decision:1",
  "title": "Decision frontmatter",
  "allOf": [
    { "$ref": "record-common.schema.json" },
    {
      "properties": {
        "record_type": { "const": "decision" },
        "lifecycle": { "enum": ["proposed", "accepted", "superseded", "deprecated", "rejected", "retired"] }
      }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "accepted" } }, "required": ["lifecycle"] },
      "then": {
        "properties": {
          "freshness": { "const": "current" },
          "verification": { "enum": ["owner_reviewed", "repository_evidence"] }
        }
      }
    }
  ]
}

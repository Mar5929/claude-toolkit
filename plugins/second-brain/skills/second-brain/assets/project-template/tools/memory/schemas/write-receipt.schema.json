{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-brain-v2:write-receipt:1",
  "title": "Deterministic knowledge write receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "repository_id", "baseline_head", "in_scope_paths", "changed_paths", "changes", "evidence", "validation", "index_state", "commit"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string" },
    "repository_id": { "type": "string", "format": "uuid" },
    "baseline_head": { "type": "string" },
    "in_scope_paths": { "type": "array", "items": { "type": "string" } },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "changes": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "object" },
    "index_state": { "enum": ["not_enabled", "stale"] },
    "commit": { "type": ["string", "null"] }
  }
}

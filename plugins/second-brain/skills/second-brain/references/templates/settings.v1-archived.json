{
  "_comment": "ARCHIVED V1 TEMPLATE. Do not copy or merge it. Use project-sync to deactivate or remove an existing local v1 integration with owner approval.",
  "env": {
    "BRAIN_BACKEND": "mcp",
    "BRAIN_MCP_ORIGIN": "<BRAIN_MCP_ORIGIN>",
    "BRAIN_PROJECT": "<PROJECT_ID>",
    "BRAIN_CONNECTOR": "<the claude.ai connector name for THIS project's brain, e.g. Anchor Brain; the scope guard uses it to tell this project's brain from another project's>",
    "BRAIN_V1_WRITE_MODE": "read-only",
    "BRAIN_CAPTURE": "0",
    "BRAIN_CURATE_ON_END": "0",
    "BRAIN_RECALL": "0",
    "BRAIN_KC_NUDGE": "0",
    "BRAIN_INJECT": "1",
    "KB_SOURCE_PATHS": "<comma-separated source paths to watch for knowledge-layer drift, from the curator profile's Source code path(s), e.g. src,worker or Anchor; empty disables the freshness hook>",
    "GRAPH_BACKEND": "<local|cloud|hybrid, only if the structural layer is installed; the owner's storage answer, usually local>"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-mcp-session-digest.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/work-items-status.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-outbox-status.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-mcp-recall.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-mcp-capture.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/kb_freshness_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-mcp-session-curate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-scope-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/knowledge-curator-nudge.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

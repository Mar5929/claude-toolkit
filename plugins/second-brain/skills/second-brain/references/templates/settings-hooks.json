{
  "_comment": "MERGE these keys into the host project's .claude/settings.json. Do not clobber existing env/hooks entries. Deliberately NO BRAIN_BRANCH key: the lib defaults it (main when BRAIN_REMOTE is set, second-brain in legacy orphan-branch mode). Exporting a branch machine-wide is what caused the origin project's publish-to-main incident; leave it unset.",
  "env": {
    "BRAIN_ENABLED": "1",
    "BRAIN_INJECT": "1",
    "BRAIN_RETRIEVE": "1",
    "BRAIN_CAPTURE": "1",
    "BRAIN_AUTORUN": "1",
    "BRAIN_AUTOSYNC": "1",
    "BRAIN_REMOTE": "<BRAIN_REMOTE_URL>",
    "BRAIN_MODEL": "<MODEL>",
    "BRAIN_KNOWLEDGE": "1",
    "BRAIN_CODE_PATH_REGEX": "<CODE_PATH_REGEX>",
    "BRAIN_CURATOR_TIMEOUT": "1200",
    "BRAIN_CURATOR_INTERVAL": "900"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/brain-repair.sh" },
          { "type": "command", "command": "bash .claude/hooks/brain-hydrate.sh" },
          { "type": "command", "command": "bash .claude/hooks/brain-inject.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/brain-retrieve.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/brain-capture.sh" }
        ]
      }
    ]
  }
}

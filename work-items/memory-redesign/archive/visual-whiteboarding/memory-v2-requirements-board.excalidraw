    },
    {
      "type": "text", "id": "s5_verbs", "x": 90, "y": 2604, "width": 620, "height": 33,
      "text": "do nothing | add | confirm | correct | supersede | retire | merge | delete\neach verb has guardrails; every one passes through the gate (scene 4)",
      "originalText": "do nothing | add | confirm | correct | supersede | retire | merge | delete\neach verb has guardrails; every one passes through the gate (scene 4)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150041, "version": 1, "versionNonce": 150042, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "s5_g1", "x": 90, "y": 2680, "width": 300, "height": 49,
      "text": "MERGE refused when it would\nblur two sources' origin or\nmeaning (FR-026)",
      "originalText": "MERGE refused when it would\nblur two sources' origin or\nmeaning (FR-026)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,

    {
      "type": "text", "id": "s6_mig", "x": 1080, "y": 2904, "width": 620, "height": 66,
      "text": "dry run first: shows every move, changes nothing. stops on ambiguity or\ncollision. missing metadata shown as missing, never invented. reversible\nuntil links, views, and checks pass. old records upgrade when touched -\nno risky bulk rewrite.",
      "originalText": "dry run first: shows every move, changes nothing. stops on ambiguity or\ncollision. missing metadata shown as missing, never invented. reversible\nuntil links, views, and checks pass. old records upgrade when touched -\nno risky bulk rewrite.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,

      "text": "DELETE only for: duplicate surplus,\ncorruption, privacy, accident -\nand only with a reason (FR-027)",
      "originalText": "DELETE only for: duplicate surplus,\ncorruption, privacy, accident -\nand only with a reason (FR-027)",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",

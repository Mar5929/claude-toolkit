    },
    {
      "type": "text", "id": "foot_hdr", "x": 40, "y": 3130, "width": 620, "height": 18,
      "text": "ACCEPTED ONLY WHEN PROVEN IN A REAL PROJECT (spec section 7):",
      "originalText": "ACCEPTED ONLY WHEN PROVEN IN A REAL PROJECT (spec section 7):",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 170001, "version": 1, "versionNonce": 170002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "foot_body", "x": 40, "y": 3154, "width": 1180, "height": 33,
      "text": "cold Claude + cold Codex sessions both start oriented; a passing detail produces no save; a superseded record leaves answers but keeps history;\nrebuilt search aids give the same answers; and the boot brief FEELS right to you - that last one is a real acceptance criterion.",
      "originalText": "cold Claude + cold Codex sessions both start oriented; a passing detail produces no save; a superseded record leaves answers but keeps history;\nrebuilt search aids give the same answers; and the boot brief FEELS right to you - that last one is a real acceptance criterion.",

    },
    {
      "type": "text",
      "id": "foot_hdr",
      "x": 40,
      "y": 3130,
      "width": 620,
      "height": 18,
      "text": "ACCEPTED ONLY WHEN PROVEN IN A REAL PROJECT (spec section 7):",
      "originalText": "ACCEPTED ONLY WHEN PROVEN IN A REAL PROJECT (spec section 7):",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e40af",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 170001,
      "version": 2,
      "versionNonce": 1320439521,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "containerId": null,

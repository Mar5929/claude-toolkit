      "y": 2880,
      "width": 480,
      "height": 18,
      "text": "MOVING AN EXISTING PROJECT IN (FR-051 to FR-055)",
      "originalText": "MOVING AN EXISTING PROJECT IN (FR-051 to FR-055)",
      "fontSize": 14,
      "fontFamily": 3,

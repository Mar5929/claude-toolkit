    {
      "type": "text",
      "id": "s2_deep",
      "x": 1129.2306665028498,
      "y": 948.8677410911266,
      "width": 700,
      "height": 66,
      "text": "high-stakes answer? do not trust the summary: open the full record and\nfollow its provenance links back to the original evidence (FR-034).\nsmarter search add-ons (embeddings etc.) only if they measurably help,\nand never past the privacy boundary without consent (FR-037).",
      "originalText": "high-stakes answer? do not trust the summary: open the full record and\nfollow its provenance links back to the original evidence (FR-034).\nsmarter search add-ons (embeddings etc.) only if they measurably help,\nand never past the privacy boundary without consent (FR-037).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",

      "autoResize": true
    },
    {
      "type": "text",
      "id": "foot_body",
      "x": 40,
      "y": 3154,
      "width": 1180,
      "height": 33,
      "text": "cold Claude + cold Codex sessions both start oriented; a passing detail produces no save; a superseded record leaves answers but keeps history;\nrebuilt search aids give the same answers; and the boot brief FEELS right to you - that last one is a real acceptance criterion.",
      "originalText": "cold Claude + cold Codex sessions both start oriented; a passing detail produces no save; a superseded record leaves answers but keeps history;\nrebuilt search aids give the same answers; and the boot brief FEELS right to you - that last one is a real acceptance criterion.",
